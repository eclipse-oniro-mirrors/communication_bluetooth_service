import("//build/ohos.gni")

ohos_shared_library("bt_vendor_service") {
  sources = [
    "vendor_interface.cpp",
  ]

  # bt_vendor.h lives in the bluetooth part, so it has to come in through
  # external_deps (an innerapi dependency) instead of a raw include_dirs entry:
  # gn rejects a target of one part reaching into another part's header
  # directory directly ("Do not directly use header files of other components").
  external_deps = [
    "bluetooth:vendor_interface",
  ]

  cflags_cc = [
    "-std=c++17",
    "-Wno-return-type-c-linkage",
  ]

  subsystem_name = "communication"
  part_name = "bluetooth_service"
  install_images = [ "system" ]
}
