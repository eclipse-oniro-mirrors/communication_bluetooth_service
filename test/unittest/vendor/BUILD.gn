import("//build/test.gni")

module_output_path = "bluetooth_service/bluetooth_service"

VENDOR_DIR = "//foundation/communication/bluetooth_service/services/bluetooth/stack/vendor"

ohos_unittest("btfw_vendor_unit_test") {
  module_out_path = module_output_path

  cflags = [ "-Wno-return-type-c-linkage" ]
  cflags_cc = [ "-Wno-error=return-type-c-linkage" ]

  sources = [ "vendor_interface_test.cpp" ]

  deps = [ "$VENDOR_DIR:bt_vendor_service" ]

  external_deps = [
    "bluetooth:vendor_interface",
    "googletest:gtest",
    "googletest:gtest_main",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":btfw_vendor_unit_test" ]
}
