        });
        scAssertBleScanHit(hits);
      }
      scScannerOffFind(scn, cb);
      await scScannerStopScan(scn);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_BLE2_CREATEGATTCLIENT_PEER
     * @tc.name ble2_createGattClient_peer
     * @tc.desc L1: enable → createGattClientDevice(fake) peer path
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('ble2_createGattClient_peer', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const client = ble.createGattClientDevice(SC_FAKE_MAC);
      try {
        client.close();
      } catch (e) {
        LogUtil.error(JSON.stringify(e));
      }
      assertLocalOk(0);
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_BLE2_QUAD_ADV_SCAN_STATE
     * @tc.name ble2_quad_adv_scan_state
     * @tc.desc L2: startAdvertising → startBLEScan → listen hit → STATE_ON
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('ble2_quad_adv_scan_state', 0, async () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      assertLocalOk(scInvoke(() => {
        ble.startAdvertising(bleAs(), bleAd());
      }));
      scSafeStopAdvertising();

      const hits: Array<ble.ScanResult> = [];
      const classicIds: Array<string> = [];
      const cb = (arr: Array<ble.ScanResult>): void => {
        scAppendBleFinds(hits, arr);
      };
      const ccb = (ids: Array<string>): void => {
        scAppendClassicFinds(classicIds, ids);
      };
      assertLocalOk(scBleOnFind(cb));
      assertLocalOk(scClassicOnFind(ccb));

      const eDisc = await scPrepareAndStartClassicDiscovery(classicIds);
      LogUtil.info('startDiscovery err=' + eDisc);
      assertLocalOk(eDisc);
      await new Promise<void>((resolve: () => void) => {
        setTimeout(resolve, SC_CLASSIC_FIND_WAIT_MS);
      });
      scSafeStopDiscovery();
      const eScan = scStartBleScan(null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_BALANCED));
      LogUtil.info('startBLEScan err=' + eScan);
      assertLocalOk(eScan);

      scAssertStateOn(scGetState());

      await new Promise<void>((resolve: () => void) => {
        setTimeout(resolve, SC_BLE_FIND_WAIT_MS);
      });
      scBleOffFind(cb);
      scClassicOffFind(ccb);
      scSafeStopBleScan();
      scSafeStopDiscovery();
      scSafeStopAdvertising();
      scAssertAmbientFindHit(hits, classicIds);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_BLE2_DISABLE_STARTADV
     * @tc.name ble2_disable_startAdv
     * @tc.desc L1: disable → startAdvertising must fail (cannot advertise)
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('ble2_disable_startAdv', 0, async () => {
      assertLocalOk(scDisable());
      scAssertStateOff(await scAwaitStateOff(2500));
      const err = scInvoke(() => {
        ble.startAdvertising(bleAs(), bleAd());
      });
      LogUtil.info('adv while off err=' + err);
      scAssertLocalFailOrBtOff(err);
      scSafeStopAdvertising();
      }, 45000);

  });
}
