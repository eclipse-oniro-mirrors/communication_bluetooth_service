      const p2 = a2dp.createA2dpSrcProfile();
      expect(p1 !== undefined).assertTrue();
      expect(p2 !== undefined).assertTrue();
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_MULTI_SPPLISTEN_X3
     * @tc.name multi_sppListen_x3
