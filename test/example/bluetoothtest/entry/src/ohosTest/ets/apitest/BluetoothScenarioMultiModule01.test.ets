      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const g1 = bluetooth.BLE.createGattServer();
      const g2 = ble.createGattServer();
      expect(g1 !== undefined).assertTrue();
      expect(g2 !== undefined).assertTrue();
      try {
        g1.close();
      } catch (e1) {
        LogUtil.error(JSON.stringify(e1));
      }
      scSafeCloseGatt(g2);
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_MULTI_ADV_AND_SCAN_REPEAT
     * @tc.name multi_adv_and_scan_repeat
     * @tc.desc L4: startBLEScan listen hit → stop (×2 rounds)
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('multi_adv_and_scan_repeat', 0, async () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const runRound = async (round: number): Promise<void> => {
        LogUtil.info('adv_scan round=' + round);
        scSafeStopBleScan();
        scSafeStopDiscovery();
        const hits: Array<ble.ScanResult> = [];
        const classicIds: Array<string> = [];
        const cb = (arr: Array<ble.ScanResult>): void => {
          scAppendBleFinds(hits, arr);
        };
        const ccb = (ids: Array<string>): void => {
          scAppendClassicFinds(classicIds, ids);
        };
        assertLocalOk(scBleOnFind(cb));
        assertLocalOk(scClassicOnFind(ccb));
        assertLocalOk(await scPrepareAndStartClassicDiscovery(classicIds));
        await new Promise<void>((resolve: () => void) => {
          setTimeout(resolve, SC_CLASSIC_FIND_WAIT_MS);
        });
        scSafeStopDiscovery();
        assertLocalOk(scStartBleScan(null, scAmbientScanOpt()));
        await new Promise<void>((resolve: () => void) => {
          setTimeout(resolve, SC_BLE_FIND_WAIT_MS);
        });
        scBleOffFind(cb);
        scClassicOffFind(ccb);
        scSafeStopBleScan();
        scSafeStopDiscovery();
        scAssertAmbientFindHit(hits, classicIds);
      };
      await runRound(0);
      await runRound(1);
      }, 45000);

