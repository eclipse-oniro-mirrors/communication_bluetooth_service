     */
    it('multi_bleScanner_startScan_x2', 0, async () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const s1 = ble.createBleScanner();
      const s2 = ble.createBleScanner();
      const e1 = await scScannerStartScan(s1, null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_LOW_POWER));
      const e2 = await scScannerStartScan(s2, null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_BALANCED));
      LogUtil.info('multi scanner e1=' + e1 + ' e2=' + e2);
      if (e1 === 801 || e2 === 801) {
        expect(e1 === 801 || e2 === 801).assertTrue();
      } else {
        assertLocalOk(e1);
        assertLocalOk(e2);
      }
      await scScannerStopScan(s1);
      await scScannerStopScan(s2);
      }, 45000);


