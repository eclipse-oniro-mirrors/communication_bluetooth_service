      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      for (let i = 0; i < 3; i++) {
        const name = 'multi_spp_' + i;
        assertLocalOk(scInvoke(() => {
          socket.sppListen(name, sppOpt(), () => {
          });
        }));
      }
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_MULTI_BLESCANNER_STARTSCAN_X2
     * @tc.name multi_bleScanner_startScan_x2
     * @tc.desc L4: two BleScanners startScan then stop (801=unsupported ok)
