      if (scGetState() !== access.BluetoothState.STATE_ON) {
        scEnable();
        await scDismissBtEnableDialog(2000);
        await new Promise<void>((resolve: () => void) => {
          setTimeout(resolve, 1500);
        });
      }
    });

    /**
