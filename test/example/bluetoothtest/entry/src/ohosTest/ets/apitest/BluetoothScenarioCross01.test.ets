      await new Promise<void>((resolve: () => void) => {
        setTimeout(resolve, SC_BLE_FIND_WAIT_MS);
      });
      scBleOffFind(cb);
      scClassicOffFind(ccb);
      scSafeStopBleScan();
      scSafeStopDiscovery();
      scSafeStopDiscovery();
      scAssertBleCannotScan(eScan, hits);

      assertLocalOk(scEnable());
      scAssertStateOn(await scAwaitStateOn(5000));
