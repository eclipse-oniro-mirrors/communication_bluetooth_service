    it('cross_sppListen_and_advertising', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      assertLocalOk(scInvoke(() => {
        socket.sppListen('cross', sppOpt(), () => {
        });
      }));
      scSafeStopAdvertising();
      const eAdv = scInvoke(() => {
        ble.startAdvertising(bleAs(), bleAd());
      });
      LogUtil.info('cross adv err=' + eAdv);
      assertLocalOk(eAdv);
      const eStop = scInvoke(() => {
        ble.stopAdvertising();
      });
      LogUtil.info('cross stopAdv err=' + eStop);
      // If start hit resource limit, stop may return invalid-adv-id (2902055).
      if (eAdv === 0) {
        assertLocalOk(eStop);
      }
    });


