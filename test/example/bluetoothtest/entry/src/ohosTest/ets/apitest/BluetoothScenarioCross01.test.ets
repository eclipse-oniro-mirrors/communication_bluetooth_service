    it('cross_a2dp_base_and_conn_profile', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const p = a2dp.createA2dpSrcProfile();
      const cb = (_s: baseProfile.StateChangeParam): void => {
        LogUtil.info('cross a2dp');
      };
      assertLocalOk(scInvoke(() => {
        p.on('connectionStateChange', cb);
      }));
      let pcs = -1;
      assertLocalOk(scInvoke(() => {
        pcs = connection.getProfileConnectionState(constant.ProfileId.PROFILE_A2DP_SOURCE) as number;
      }));
      expect(pcs).assertEqual(constant.ProfileConnectionState.STATE_DISCONNECTED);
      const prev = scGetLocalName();
      const want = 'ScA2dpName';
      scAssertNameRoundTrip(scSetLocalName(want), want);
      scRestoreName(prev);
      assertLocalOk(scInvoke(() => {
        p.off('connectionStateChange', cb);
      }));
    });


