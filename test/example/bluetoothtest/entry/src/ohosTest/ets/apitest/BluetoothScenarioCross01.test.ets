      const classicIds: Array<string> = [];
      const cb = (arr: Array<ble.ScanResult>): void => {
        scAppendBleFinds(hits, arr);
      };
      const ccb = (ids: Array<string>): void => {
        scAppendClassicFinds(classicIds, ids);
      };
      assertLocalOk(scBleOnFind(cb));
      assertLocalOk(scClassicOnFind(ccb));

      scSafeStopDiscovery();
      const eScan = scStartBleScan(null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_LOW_POWER));
      LogUtil.info('startBLEScan err=' + eScan);

      const eDisc = scInvoke(() => {
        connection.startBluetoothDiscovery();
      });
      const eListen = scInvoke(() => {
        socket.sppListen('xoff', sppOpt(), () => {
        });
      });
      LogUtil.info('off scan=' + eScan + ' disc=' + eDisc + ' listen=' + eListen);
      assertLocalOk(eDisc);
