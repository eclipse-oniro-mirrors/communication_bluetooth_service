    it('cross_discovery_and_bleScan', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      assertLocalOk(scInvoke(() => {
        connection.startBluetoothDiscovery();
      }));
      assertLocalOk(scInvoke(() => {
        ble.startBLEScan(scFilterEmpty(), scScanOpt(0, ble.ScanDuty.SCAN_MODE_LOW_POWER));
      }));
      assertLocalOk(scInvoke(() => {
        connection.stopBluetoothDiscovery();
      }));
      assertLocalOk(scInvoke(() => {
        ble.stopBLEScan();
      }));
      assertLocalOk(scInvoke(() => {
        connection.getPairedDevices();
      }));
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_CROSS_GATT_A2DP_PROFILECONN
     * @tc.name cross_gatt_a2dp_profileConn
     * @tc.desc L3: enable → createGattServer → createA2dpSrcProfile → getProfileConnectionState → close
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('cross_gatt_a2dp_profileConn', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());

      const gs = ble.createGattServer();
      const p = a2dp.createA2dpSrcProfile();
      expect(p !== undefined).assertTrue();
      assertLocalOk(scInvoke(() => {
        connection.getProfileConnectionState(constant.ProfileId.PROFILE_A2DP_SOURCE);
      }));
      scSafeCloseGatt(gs);
    });


