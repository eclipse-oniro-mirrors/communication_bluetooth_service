    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_SCAN_AFTER_DISABLE
     * @tc.name scan_after_disable
     * @tc.desc disable → startBLEScan → fail or listen miss (cannot scan)
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('scan_after_disable', 0, async () => {
      assertLocalOk(scDisable());
      scAssertStateOff(await scAwaitStateOff(2500));

      const hits: Array<ble.ScanResult> = [];
      const classicIds: Array<string> = [];
      const cb = (arr: Array<ble.ScanResult>): void => {
        scAppendBleFinds(hits, arr);
      };
      const ccb = (ids: Array<string>): void => {
        scAppendClassicFinds(classicIds, ids);
      };
      assertLocalOk(scBleOnFind(cb));
      assertLocalOk(scClassicOnFind(ccb));

      scSafeStopDiscovery();
      const e1 = scStartBleScan(null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_LOW_POWER));
      LogUtil.info('startBLEScan err=' + e1);

      await new Promise<void>((resolve: () => void) => {
        setTimeout(resolve, SC_BLE_FIND_WAIT_MS);
      });
      scBleOffFind(cb);
      scClassicOffFind(ccb);
      scSafeStopBleScan();
      scSafeStopDiscovery();

      scAssertBleCannotScan(e1, hits);
      }, 45000);


