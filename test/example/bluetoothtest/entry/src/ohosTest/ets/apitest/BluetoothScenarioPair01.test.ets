     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_DISABLE_STARTBLESCAN
     * @tc.name pair_disable_startBleScan
     * @tc.desc 2-way: disableBluetooth then startBLEScan cannot scan (fail or miss)
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_disable_startBleScan', 0, async () => {
      const eDis = scDisable();
      assertLocalOk(eDis);
      scAssertStateOff(await scAwaitStateOff(2500));

      const hits: Array<ble.ScanResult> = [];
      const classicIds: Array<string> = [];
      const cb = (arr: Array<ble.ScanResult>): void => {
        scAppendBleFinds(hits, arr);
      };
      const ccb = (ids: Array<string>): void => {
        scAppendClassicFinds(classicIds, ids);
      };
      assertLocalOk(scBleOnFind(cb));
      assertLocalOk(scClassicOnFind(ccb));

      scSafeStopDiscovery();
      const err = scStartBleScan(null, scScanOpt(0, ble.ScanDuty.SCAN_MODE_LOW_POWER));
      LogUtil.info('startBLEScan err=' + err);

      await new Promise<void>((resolve: () => void) => {
        setTimeout(resolve, SC_BLE_FIND_WAIT_MS);
      });
      scBleOffFind(cb);
      scClassicOffFind(ccb);
      scSafeStopBleScan();
      scSafeStopDiscovery();

      scAssertBleCannotScan(err, hits);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_DISABLE_CREATEGATTSERVER
     * @tc.name pair_disable_createGattServer
     * @tc.desc 2-way: disableBluetooth then createGattServer
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_disable_createGattServer', 0, () => {
      const eDis = scDisable();
      assertLocalOk(eDis);
      let gs: ble.GattServer | undefined = undefined;
      const err = scInvoke(() => {
        gs = ble.createGattServer();
      });
      LogUtil.info('pair disable+createGattServer err=' + err);
      assertLocalOk(err);
      if (gs !== undefined) {
        scSafeCloseGatt(gs);
      }
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_NAME_CAN_SET
     * @tc.name pair_name_can_set
     * @tc.desc 2-way: BT ON setLocalName succeeds and getLocalName matches
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_name_can_set', 0, () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());
      const prev = scGetLocalName();
      const want = 'ScCanSet';
      scAssertNameRoundTrip(scSetLocalName(want), want);
      scRestoreName(prev);
    });


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_NAME_CANNOT_SET_BT_OFF
     * @tc.name pair_name_cannot_set_bt_off
     * @tc.desc 2-way: BT OFF setLocalName must fail or leave name unchanged
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_name_cannot_set_bt_off', 0, async () => {
      assertLocalOk(scEnable());
      scAssertStateOn(scWaitStateOn());
      const prev = scGetLocalName();
      assertLocalOk(scDisable());
      scAssertStateOff(await scAwaitStateOff(2500));
      const err = scSetLocalName('ScCannotSet');
      scAssertNameCannotSet(err, prev);
      assertLocalOk(scEnable());
      scAssertStateOn(await scAwaitStateOn(5000));
      scRestoreName(prev);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_ORDER_OFF_THEN_ON
     * @tc.name pair_order_off_then_on
     * @tc.desc 2-way order: disable then enable → ON|TURNING_ON
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_order_off_then_on', 0, async () => {
      assertLocalOk(scDisable());
      assertLocalOk(scEnable());
      const st = await scAwaitStateOn(2500);
      LogUtil.info('pair off->on st=' + st);
      scAssertStateOn(st);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_ORDER_ON_THEN_OFF
     * @tc.name pair_order_on_then_off
     * @tc.desc 2-way order: enable then disable → OFF|TURNING_OFF
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_order_on_then_off', 0, async () => {
      assertLocalOk(scEnable());
      scAssertStateOn(await scAwaitStateOn(2500));
      const eDis = scDisable();
      assertLocalOk(eDis);
      const st = await scAwaitStateOff(2500);
      LogUtil.info('pair on->off err=' + eDis + ' st=' + st);
      scAssertStateOff(st);
      }, 45000);


    /**
     * @tc.number SUB_BLUETOOTHTEST_APITEST_SCENARIO_PAIR_ENABLE_GETSTATE_X3
     * @tc.name pair_enable_getState_x3
     * @tc.desc 2-way repeated: enable+getState x3
     * @tc.size MediumTest
     * @tc.type Function
     * @tc.level Level 2
     */
    it('pair_enable_getState_x3', 0, () => {
      scRepeat('pair_enable_getState', 3, () => {
        assertLocalOk(scEnable());
        scAssertStateOn(scWaitStateOn());
      });
    });

  });
